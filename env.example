# Copy this file to .env before running `agentengine dev up`.
#
MONGODB_URI=

# Shared POC state used to resolve production seed inputs and publish the latest
# validated seed pointer. Use separate least-privilege credentials in deployment.
SHARED_STATE_MONGODB_URI=
SHARED_STATE_DATABASE=poc_builder
SHARED_STATE_COLLECTION=pocs

# Prevent generated package.json and manifest files from restarting local agent
# services during an active local generation workflow.
AGENTENGINE_DEV_WATCH=0

# OpenAI-compatible LLM configuration.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-astra

# GitHub repository settings for production artifact tools.
GITHUB_USERNAME=
GITHUB_TOKEN=
# Canonical owner/repository form, for example nish92rao/magenta-test-repo.
GITHUB_REPO=

# Public validator API configuration. Store the HMAC value as a platform secret.
SEED_VALIDATOR_URL=
SEED_VALIDATOR_HMAC_SECRET=
SEED_VALIDATOR_TIMEOUT_SECONDS=24
# Protected runtime secret for Lambda's capped validation database. Do not
# include this URI in the AgentEnvelope or any model-visible argument. This
# must use a dedicated validation cluster/account with no target-cluster access.
SEED_VALIDATION_MONGODB_URI=

# Step 19 test configuration. Integration tests create and always drop a
# unique database. Non-local endpoints require ALLOW_NONLOCAL_INTEGRATION_MONGODB=1.
INTEGRATION_MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
ALLOW_NONLOCAL_INTEGRATION_MONGODB=0
# Shared GitHub/Lambda tests also require the GitHub and validator values above.
RUN_LIVE_TESTS=0

# Explicit Step 20 two-cluster isolation proof. These must identify different
# endpoints and separately permissioned users. They are never printed.
SECURITY_VALIDATION_MONGODB_URI=
SECURITY_TARGET_MONGODB_URI=

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=
